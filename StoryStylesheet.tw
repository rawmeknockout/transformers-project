:: StoryStylesheet [stylesheet]
@font-face {
    font-family: "Dogica";
    src: url(fonts/dogicapixelbold.ttf) format("truetype");
    font-style: normal;
    font-weight: 300;
}

#story-title {
 	padding: 8px; 
}

h1 {
 	font-family: 'White Rabbit';
    font-size: 250%;
  	
}

#character {
  	background-color: white;
  	width: 100px;
 	height: 100px;
 	bottom: 0px; 
 	right: 0px;
  
}

#approval {
  	border: 1px solid #444;
	border-radius: 4rem;
  	border-width: 3px;
  
}

#passages {
	border: 1px solid #444;
	border-radius: 4rem;
  	border-width: 3px;
  	border-color: #13919e;
  	display: flex;
}

.passage {
  	margin: 20px 8px 20px 22px;
  	width: 100%;
  	padding: 10px 0px;
  	color: white;
  	font-size: 100%;
  	font-family: 'White Rabbit';
  	font-weight: 300;
  	font-style: normal;
  	text-align: justify; 
  	position: relative; 
  	left: 0em;
  	right: 0em;
  	max-width: 915px;
  	overflow-wrap: break text;
  	
}


body {
	font-family: 'White Rabbit';
	font-size: 18px;
  	color: white;
  	position: center;
  	background-color: #000000;

}

kinktext {
  	color: hotpink;
}

#ui-dialog-titlebar {
	border-radius: 1rem;
    background-color: transparent;
  	padding: 5px;
}

#ui-dialog-title {
 	text-transform: capitalize; 
}

#ui-dialog-body {
  	border-radius: 1rem;
  	border: 0px;  	
}

#ui-dialog-body ul.buttons li button#restart-ok {
  	border-radius: 2rem;
  	background-color: #c40010;
  	border: 0px;
}

#ui-dialog-body ul.buttons li button#restart-cancel {
  	border-radius: 2rem;
  	background-color: #c40010;
  	border: 0px;
}

#ui-dialog-body.saves ul.buttons li button#saves-export {
  	border: 0px;
  	background-color: #c90000;
  	border-radius: 2rem;
}

#ui-dialog-body.saves ul.buttons li button#saves-import {
	border: 0px;
  	background-color: #632bfc;
  	border-radius: 2rem;
}

#ui-dialog-body.saves ul.buttons li button#saves-clear {
	border: 0px;
  	background-color: #0fb4f5;
  	border-radius: 2rem;
}

#ui-dialog-body.saves ul.buttons li button#saves-disk-save {
  	border: 0px;
  	background-color: #c90000;
  	border-radius: 2rem;
}

#ui-dialog-body.saves ul.buttons li button#saves-disk-load {
	border: 0px;
  	background-color: #632bfc;
  	border-radius: 2rem;
}

.dialogueBorder {
 	border: 1px solid #444;
	border-radius: 2rem;
  	border-width: 3px;
  	margin: 15px;
  
}

.dialogue {
	margin-left: 30px;
  	margin-top: 0px;
  	margin-right: 30px;
  	margin-bottom: 0px;
  	color: white;
  	text-align: justify;
  	position: relative; 
  	font-size: 17px;
  	padding-top: 0em;

}

.passage a, .passage a:hover, .passage a:active {
  	color: #6fc2fc;
  	text-shadow: 0px 0px 20px #259de8;
	text-decoration: underline;
}

.hover {
    position: relative;
    display: inline-block;
}

.hover .hoverblock {
    visibility: hidden;
    width: 120px;
    background-color: black;
    color: white;
    border-color: white;
    border-style: double;
    text-align: center;
    border-radius: 6px;
    padding: 5px 0;
    position: absolute;
    z-index: 1;
}

.hover:hover .hoverblock {
    visibility: visible;
}


#passages button {
  	border: 0px;
	border-radius: 1rem;
  	border-width: 1px;
  	background-color: #259de8;
  	position: center;  
}

#passages link {
 	margin: 20px; 
  
}




#ui-bar {
 	 background-color: #000000;
}


#menu ul {
  	padding: 0px;
	border: 1px solid #444;
	border-radius: 1rem;
  	border-width: 2px;
  	border-color: #13919e;
}


#menu li a {
  	padding: .3em .8em;
  	text-transform: capitalize;
}

#menu li a:hover {
 	border-radius: 2rem;
  	background-color: #42e0f5;
  	color: green;
}

#menu-story li a:before {
  	font-family: sc-icons;
  	content: ;
  	color: ;
}

#menu-item-saves a:before {
  	content: "\f019\00a0";
  
}

button#history-backward {
 	border-radius: 0.2em; 
}

button#history-forward {
 	border-radius: 0.2em; 
}

button#ui-bar-toggle {
 	border-radius: 0.2em; 
}

#ui-bar-tray #history-backward::before {
 	content: "\f04a\00a0"; 
  	color: ;
}

#ui-bar-tray #history-forward::before {
 	content: "\f04e\00a0";
  	color: ;
}




     
img {
 	border: 2px solid #444;
	border-radius: 1rem;
  	border-width: 2px; 
  	margin: 8px;
  	border-color: #FFFFFF;
}

.flex-container {
  display: flex;
  justify-content: space-between;
  gap: 1em;
}

.flex-box {
  flex: 1;
  background-color: #303030;
  padding: 1em;
  border-radius: 2rem;
  border-color: #303030;
}

.hide {
 	display: none; 
  
}

















||||||||||||























.shadow {
	text-shadow: 0.08em 0.08em 0.08em #FFF;
}
.emboss {
	text-shadow: 0.08em 0.08em 0em #FFF;
	color: black;
}
.blur {
	color: transparent;
	text-shadow: 0em 0em 0.08em #FFF;
}
.blurrier {
	color: transparent;
	text-shadow: 0em 0em 0.2em #FFF;
}
.blurrier::selection {
	background-color: transparent;
	color: transparent;
}
.blurrier::-moz-selection {
	background-color: transparent;
	color: transparent;
}
.smear {
	color: transparent;
	text-shadow:
		0em    0em 0.02em rgba(255,255,255,0.75),
		-0.2em 0em 0.5em  rgba(255,255,255,0.5),
		0.2em  0em 0.5em  rgba(255,255,255,0.5);
}
.mirror {
	display: inline-block;
	transform: scaleX(-1);
	-webkit-transform: scaleX(-1);
}
.upside-down {
	display: inline-block;
	transform: scaleY(-1);
	-webkit-transform: scaleY(-1);
}

@-webkit-keyframes fade-in-out {
	0%,
	to {opacity: 0}
	50% {opacity: 1}
}
@keyframes fade-in-out {
	0%,
	to {opacity: 0}
	50% {opacity: 1}
}
.fade-in-out {
	text-decoration: none;
	animation: fade-in-out 2s ease-in-out infinite alternate;
	-webkit-animation: fade-in-out 2s ease-in-out infinite alternate;
}

@-webkit-keyframes rumble {
	50% {
		-webkit-transform: translateY(-.2em);
		transform: translateY(-.2em)
	}
}
@keyframes rumble {
	50% {
		-webkit-transform: translateY(-.2em);
		transform: translateY(-.2em)
	}
}
.rumble {
	-webkit-animation: rumble linear 0.1s 0s infinite;
	animation: rumble linear 0.1s 0s infinite;
	display:inline-block;
}

@-webkit-keyframes shudder {
	50% {
		-webkit-transform: translateX(0.2em);
		transform: translateX(0.2em)
	}
}
@keyframes shudder {
	50% {
		-webkit-transform: translateX(0.2em);
		transform: translateX(0.2em)
	}
}
.shudder {
	-webkit-animation: shudder linear 0.1s 0s infinite;
	animation: shudder linear 0.1s 0s infinite;
	display: inline-block;
}


/* SugarCube's built-in Font Awesome icons - Start */
.sc-fa {
	font-family: sc-icons;
	font-style: normal;
	font-weight: normal;
	font-variant: normal;
	text-transform: none;
	line-height: 1;
	speak: none;
}
.sc-icon {
	padding-left: 2px;
	padding-right: 2px;
}
.sc-icon::before {
	font-family: sc-icons;
	font-style: normal;
	font-weight: normal;
	font-variant: normal;
	text-transform: none;
	line-height: 1;
	speak: none;
}
.sc-bolt::before {
	content: "\f0e7";
}
.sc-check::before {
	content: "\f00c";
}
.sc-cog::before {
	content: "\f013";
}
.sc-heart::before {
	content: "\f004";
}
.sc-show::before {
	content: "\f06e";
}
.sc-sun::before {
	content: "\f185";
}
.sc-moon::before {
	content: "\f186";
}
.sc-star-solid::before {
	content: "\f005";
}
/* SugarCube's built-in Font Awesome icons - End */